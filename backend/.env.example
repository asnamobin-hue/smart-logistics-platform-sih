# Server
PORT=5001
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/logistics

# Frontend URL (for CORS) — update if your frontend runs elsewhere
CLIENT_URL=http://localhost:5173

# OpenWeatherMap API key — optional, only needed for /api/weather
WEATHER_API_KEY=

# Anthropic API key — optional, only needed for AI-powered Smart Route Intelligence.
# Without it, the AI Route Risk Analyzer automatically falls back to rule-based
# scoring (see ai/prediction/routeRiskPrediction.js) — the feature still works.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for route risk analysis
AI_MODEL=claude-3-5-sonnet-20241022

# Optional: self-hosted OSRM instance. Defaults to the public demo server.
OSRM_BASE_URL=https://router.project-osrm.org
